{
    "name": "skaut/skautis",
    "type": "library",
    "description": "Library for API calls to SkautIS",
    "keywords": [
        "skautis",
        "api",
        "soap",
        "skaut",
        "wsdl"
    ],
    "homepage": "https://github.com/skaut/Skautis",
    "license": [
        "BSD-3-Clause"
    ],
    "authors": [
        {
            "name": "František Hána",
            "homepage": "https://github.com/sinacek"
        },
        {
            "name": "Jindřich Pilař",
            "homepage": "https://github.com/JindrichPilar"
        },
        {
            "name": "Jiří Dorazil",
            "homepage": "https://github.com/juradee"
        }
    ],
    "support": {
        "wiki": "http://is.skaut.cz/napoveda/",
        "source": "https://github.com/skaut/Skautis"
    },
    "require": {
        "php": "^8.4",
        "ext-soap": "*",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "mockery/mockery": "^1.6",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-mockery": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Skaut\\Skautis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Skaut\\Skautis\\Test\\": "tests/"
        }
    },
    "suggest": {
        "skautis/nette": "Integrace Skautis do Nette",
        "crell/tukio": "Samostatná implementace PSR-14 EventDispatcher"
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "lint": "parallel-lint --no-progress src tests",
        "cs": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "stan": "phpstan analyse --no-progress --memory-limit=512M",
        "test": "phpunit",
        "ci": [
            "@lint",
            "@cs:check",
            "@stan",
            "@test"
        ]
    }
}
